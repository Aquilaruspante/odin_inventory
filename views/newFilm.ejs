<%- include('./header.ejs'); %>

<form class="form" action="/film/new" method="POST" autocomplete="off">
    <div id="form-header">
        <h2 class="oswald-title">Add Film</h2>
    </div>
    <div id="form-body">
        <div class="form-section">
            <label for="title">Title</label>
            <input class="form-input" type="text" name="title" id="title">
        </div>
        <div class="form-section">
            <label for="year">Year</label>
            <input class="form-input" type="number" name="year" id="year">
        </div>
        <div class="form-section">
            <label for="image">Image URL</label>
            <input class="form-input" type="text" name="image" id="image">
        </div>
        <div class="form-section">
            <label for="director">Director</label>
            <input class="form-input" type="text" name="director" id="director">
        </div>
        <div class="genre-input-section">
            <div class="form-section">
                <label for="genre">Genre</label>
                <input class="form-input genre-input" type="text" id="genre" name="genre" placeholder="Search or add genre..." />
            </div>
            <ul class="genre-selection-menu hidden">
                <% for (const genre of genres) { %>
                    <li class="genre-selection-element"><%= genre.name %></li>
                <% } %>
            </ul>
        </div>
        <button class="form-button">ADD</button>
    </div>
    
</form>
</main>
<script src="/toggleMenu.js"></script>
<script src="/genreFetcher.js"></script>
<script src="/genreSelector.js"></script>
</body>