<%- include('./header.ejs'); %>

<form class="form" action="/film/new" method="POST">
    <div id="form-header">
        <h2 class="oswald-title">Add Film</h2>
    </div>
    <div id="form-body">
        <div class="form-section">
            <label for="title">Title</label>
            <input class="form-input" type="text" name="title" id="title">
        </div>
        <div class="form-section">
            <label for="year">Year</label>
            <input class="form-input" type="number" name="year" id="year">
        </div>
        <div class="form-section">
            <label for="image">Image URL</label>
            <input class="form-input" type="text" name="image" id="image">
        </div>
        <div class="form-section">
            <label for="director">Director</label>
            <input class="form-input" type="text" name="director" id="director">
        </div>
        <select name="genre" id="genre-select">
            <option value="">--Please choose a genre--</option>
            <option value="drama">Drama</option>
            <option value="horror">Horror</option>
            <option value="comedy">Comedy</option>
        </select>
        <button class="form-button">ADD</button>
    </div>
    
</form>
</main>
</body>