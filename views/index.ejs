<%- include('./header.ejs'); %>

<form action="/film" class="search-form" autocomplete="off">
    <input type="text" class="genre-search-bar" placeholder="Search film" name="q">
</form>
<div class="index-container">
    <% for (const film of films) { %>
        <div class="film-card">
            <a class="film-image-container" href="/film/<%= film.id %>"><img src="<%= film.image %>" alt="<%= film.name %> image"></a>    
            <h3 class="film-title oswald-card-title"><a href="/film/<%= film.id %>"><%= film.name %></a></h3>
            <p class="genre-list">
                <a href="/genre?q=<%= film.genres[0] %>"><%= film.genres[0] %></a>
                <% for (let i = 1; i < film.genres.length; i++) { %>
                    - <a href="/genre?q=<%= film.genres[i] %>"><%= film.genres[i] %></a>
                <% } %>
            </p>
        </div>
    <% } %>
</div>
</main>
<a href="/film/new" id="new-link">
    <button id="new-button">+</button>
</a>
<div class="pages">
    <% for (i = 1; i <= (films.length / 5) + 1; i++) { %>
        <a href="/film?page=<%= i %>"><%= i %></a>
    <% } %>
</div>
<%- include('./footer.ejs') %>