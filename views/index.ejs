<%- include('./header.ejs'); %>


    <% for (const film of films) { %>
        <div class="film-card">
            <h3 class="film-title oswald-card-title"><%= film.name %></h3>
            <img src="<%= film.image %>" alt="">
            <div class="film-details">
                <p>Year: <%= film.year %></p>
                <p>Director: <%= film.director %></p>
                <p><%= film.genre %></p>
            </div>
        </div>
    <% } %>
</main>
</body>